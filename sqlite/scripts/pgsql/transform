#!/usr/bin/env python3
"""Hand-translate a PostgreSQL SQL dump into SQLite at build time.

A number of our datasets only ship as PostgreSQL dumps. Where the dump is plain
DDL + data (no PL/pgSQL, no extensions) the dialect gap is small and mechanical,
so this shared hook rewrites the SQL rather than us carrying a hand-maintained
SQLite fork of each dataset. Every dataset that needs it symlinks its
scripts/<dataset> directory to scripts/pgsql, exactly like the stackexchange
hook is shared across sites; the conversion is dataset-agnostic and keyed only
on $SQL_FILES (the files the build will cat into the sqlite3 CLI).

What it does, per file in $SQL_FILES:

  * transcodes the file to UTF-8 (some pgFoundry dumps are Latin-1);
  * converts ``COPY tbl (cols) FROM stdin`` + TEXT-format data + ``\\.`` into
    batched multi-row ``INSERT``s (SQLite has no inline COPY);
  * drops Postgres-only noise (``SET``, sequences, ``OWNER TO``, ``GRANT`` /
    ``REVOKE``, ``COMMENT ON``, ``WITH/WITHOUT OIDS``, ``DEFAULT nextval(...)``,
    ``ALTER DATABASE``, ``CREATE EXTENSION``, ``pg_catalog.set_config``,
    psql ``\\connect`` / ``\\.``), strips ``USING btree`` / ``USING hash`` /
    ``USING lsm`` access-method clauses and ``public.`` / ``cd.`` schema
    qualifiers; and
  * lower-cases table identifiers so a dump that defines ``Regions`` but loads
    ``regions`` (Postgres folds unquoted names) still resolves on SQLite;
  * rewrites ``= ANY (ARRAY[...])`` (CHECK constraints) to the equivalent
    ``IN (...)`` -- SQLite has no ANY/ARRAY;
  * drops ``ALTER TABLE ... ADD CONSTRAINT ...`` statements wholesale (SQLite
    cannot add constraints via ALTER TABLE; tables and data still load);
  * drops stored functions -- both the classic quoted/dollar-quoted ``AS``-body
    form (ends at its ``LANGUAGE <lang>;`` line) and the PostgreSQL 14+
    SQL-standard body form (``LANGUAGE sql ... RETURN <expr>;``), neither of
    which has a mechanical SQLite translation.

Datasets whose dump needs more than the shared rules opt in via environment
knobs, set by a thin dataset-specific transform hook that then delegates here
(see sqlite/scripts/airlines). Both default off, so the symlinked datasets'
output is byte-identical with or without this machinery:

  PGSQL_EXTRA_SCHEMAS   extra schema qualifiers to strip besides public/cd
                        (space- or comma-separated), e.g. ``bookings`` for the
                        airlines demo. COPY statements already de-qualify any
                        schema; this extends the DDL/INSERT rewriting.
  PGSQL_DROP_VIEWS=1    drop ``CREATE [OR REPLACE] [MATERIALIZED] VIEW``
                        statements wholesale (single- or multi-line). View
                        bodies lean on Postgres operators/functions with no
                        SQLite equivalent; the smoke test counts tables only.

Column types are kept as-is: SQLite type affinity accepts Postgres spellings
(``character varying``, ``timestamp``, ``numeric``, ``boolean``, etc.).
Unknown spellings like ``jsonb`` or ``tstzrange`` fall through the affinity
rules too, so their COPY literals load as plain text.

The output is wrapped in ``PRAGMA synchronous=OFF; BEGIN;`` / ``COMMIT;`` for
fast bulk load.
"""
import glob
import os
import re
import sys

BATCH = 500

PREAMBLE = "PRAGMA synchronous=OFF;\nPRAGMA journal_mode=MEMORY;\n\n"
POSTAMBLE = ""

# A COPY header: COPY <table> (<cols>) FROM stdin [DELIMITER 'x'];
COPY_RE = re.compile(
    r"^COPY\s+([^\s(]+)\s*\(([^)]*)\)\s+FROM\s+stdin"
    r"(?:\s+DELIMITER\s+'([^']*)')?\s*;",
    re.IGNORECASE)

# Whole DDL lines that are Postgres-only and have no SQLite equivalent we need.
DROP_LINE_RE = re.compile(
    r"^\s*(SET\s|SELECT\s+pg_catalog\.(setval|set_config)|GRANT\s|REVOKE\s|"
    r"COMMENT\s+ON|"
    r"WITHOUT\s+OIDS|USING\s+(btree|hash|lsm)\b|\\connect|\\c\s|\\\."
    r"|CREATE\s+SCHEMA|DROP\s+SCHEMA|CREATE\s+DATABASE|DROP\s+DATABASE"
    r"|ALTER\s+DATABASE|CREATE\s+EXTENSION|DROP\s+EXTENSION)\b",
    re.IGNORECASE)

# Multi-line statements to drop wholesale (from this keyword until the line that
# ends the statement with ';').
DROP_BLOCK_RE = re.compile(
    r"^\s*(CREATE\s+SEQUENCE|ALTER\s+SEQUENCE|CREATE\s+DOMAIN|CREATE\s+TYPE)\b",
    re.IGNORECASE)

# Views, dropped wholesale like the blocks above -- but only when a dataset
# opts in via PGSQL_DROP_VIEWS (see the module docstring), so the datasets that
# predate the knob keep byte-identical output.
VIEW_RE = re.compile(
    r"^\s*CREATE\s+(OR\s+REPLACE\s+)?(MATERIALIZED\s+)?VIEW\b",
    re.IGNORECASE)

# SQLite cannot add constraints via ALTER TABLE; drop these blocks wholesale
# (single-line or multi-line until ';').
ALTER_TABLE_RE = re.compile(r"^\s*ALTER\s+TABLE\b", re.IGNORECASE)

# Stored functions have no mechanical SQLite translation. Two shapes:
#   * classic AS-body: CREATE FUNCTION ... AS '...' / AS $$...$$ LANGUAGE x;
#     -- ends at the LANGUAGE line (the quoted body may itself contain `;`);
#   * SQL-standard body (PostgreSQL 14+): CREATE FUNCTION ... LANGUAGE sql ...
#     RETURN <expr>; -- no AS body, ends at the RETURN line.
# FUNC_BODY_RE detects the opening of an AS body; while none has been seen a
# terminating RETURN line ends the statement, otherwise only the LANGUAGE line
# does (a RETURN inside a quoted PL/pgSQL body must not end the block early).
FUNC_START_RE = re.compile(r"^\s*CREATE\s+(OR\s+REPLACE\s+)?FUNCTION\b",
                           re.IGNORECASE)
FUNC_END_RE = re.compile(r"\bLANGUAGE\s+\w+\s*;\s*$", re.IGNORECASE)
FUNC_BODY_RE = re.compile(r"\bAS\s*('|\$\w*\$)", re.IGNORECASE)
FUNC_RETURN_END_RE = re.compile(r"^\s*RETURN\b.*;\s*$", re.IGNORECASE)


# Schemas whose qualifier is stripped from DDL/INSERT lines. The default pair
# reproduces the historical behaviour exactly; PGSQL_EXTRA_SCHEMAS extends it
# per-dataset (see the module docstring). configure() is called at import and
# again from main(), so both the exec'd hook and a test driving main() see the
# current environment.
DEFAULT_SCHEMAS = ("public", "cd")


def configure():
    """(Re)read the environment knobs into module state."""
    global SCHEMA_RE, DROP_VIEWS
    extra = tuple(s for s in
                  re.split(r"[\s,]+", os.environ.get("PGSQL_EXTRA_SCHEMAS", ""))
                  if s)
    SCHEMA_RE = re.compile(
        r"(?i)\b({})\.".format("|".join(map(re.escape,
                                            DEFAULT_SCHEMAS + extra))))
    DROP_VIEWS = os.environ.get("PGSQL_DROP_VIEWS", "") == "1"


configure()


def transcode(path):
    with open(path, "rb") as fh:
        raw = fh.read()
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("latin-1")


def strip_schema(line):
    """Remove Postgres schema qualifiers SQLite does not use."""
    return SCHEMA_RE.sub("", line)


def clean_ddl(line):
    """Apply dialect fixes to a single DDL/statement line."""
    line = strip_schema(line)
    line = re.sub(r"(?i)\bdefault\s+nextval\([^)]*\)", "", line)
    line = re.sub(r"(?i)\balter\s+table\s+only\b", "ALTER TABLE", line)
    line = re.sub(r"(?i)\busing\s+(btree|hash|lsm)\b", "", line)
    line = re.sub(r"(?i)\bwith\s*\(\s*oids[^)]*\)", "", line)
    # Postgres type casts (e.g. 'Asia'::text) have no SQLite equivalent.
    line = re.sub(r"::\w+(?:\([^)]*\))?", "", line)
    # `x = ANY (ARRAY[a, b])` (CHECK constraints) -> the equivalent `x IN (a, b)`
    # (SQLite has no ANY/ARRAY).
    line = re.sub(r"(?i)=\s*ANY\s*\(\s*ARRAY\[([^\]]*)\]\s*\)", r"IN (\1)", line)
    line = re.sub(r"(?i)(create\s+table\s+)(\w+)",
                  lambda m: m.group(1) + m.group(2).lower(), line)
    line = re.sub(r"(?i)(alter\s+table\s+)(\w+)",
                  lambda m: m.group(1) + m.group(2).lower(), line)
    line = re.sub(r"(?i)(references\s+)(\w+)",
                  lambda m: m.group(1) + m.group(2).lower(), line)
    line = re.sub(r"(?i)(create\s+index\s+\w+\s+on\s+)(\w+)",
                  lambda m: m.group(1) + m.group(2).lower(), line)
    return line


def split_copy_row(line, delim):
    """Split a COPY TEXT row on unescaped delimiters, keeping escape pairs."""
    fields, cur, i, n = [], [], 0, len(line)
    while i < n:
        c = line[i]
        if c == "\\" and i + 1 < n:
            cur.append(line[i:i + 2]); i += 2; continue
        if c == delim:
            fields.append("".join(cur)); cur = []; i += 1; continue
        cur.append(c); i += 1
    fields.append("".join(cur))
    return fields


_UNESCAPE = {"t": "\t", "n": "\n", "r": "\r", "\\": "\\"}


def copy_value(field):
    """Render one COPY field as a SQLite string literal."""
    if field == "\\N":
        return "NULL"
    out, i = [], 0
    while i < len(field):
        if field[i] == "\\" and i + 1 < len(field):
            out.append(_UNESCAPE.get(field[i + 1], field[i + 1])); i += 2
        else:
            out.append(field[i]); i += 1
    return "'" + "".join(out).replace("'", "''") + "'"


def convert_file(text, out):
    lines = text.split("\n")
    i, n = 0, len(lines)
    drop_block = drop_func = drop_alter = func_has_body = False
    while i < n:
        line = lines[i]

        if drop_func:
            if FUNC_BODY_RE.search(line):
                func_has_body = True
            if FUNC_END_RE.search(line) or \
                    (not func_has_body and FUNC_RETURN_END_RE.match(line)):
                drop_func = False
            i += 1; continue
        if drop_block:
            if ";" in line:
                drop_block = False
            i += 1; continue
        if drop_alter:
            if ";" in line:
                drop_alter = False
            i += 1; continue

        m = COPY_RE.match(line)
        if m:
            table, cols, delim = m.group(1), m.group(2), m.group(3) or "\t"
            table = table.split(".")[-1].lower()
            head = "INSERT INTO {} ({}) VALUES\n".format(table, cols)
            batch = []
            i += 1
            while i < n and lines[i].rstrip() != "\\.":
                row = split_copy_row(lines[i], delim)
                batch.append("(" + ", ".join(copy_value(f) for f in row) + ")")
                if len(batch) >= BATCH:
                    out.write(head + ",\n".join(batch) + ";\n")
                    batch = []
                i += 1
            if batch:
                out.write(head + ",\n".join(batch) + ";\n")
            i += 1  # skip the \. terminator
            continue

        if FUNC_START_RE.match(line):
            func_has_body = bool(FUNC_BODY_RE.search(line))
            drop_func = not FUNC_END_RE.search(line)
            i += 1; continue
        if ALTER_TABLE_RE.match(line):
            drop_alter = ";" not in line
            i += 1; continue
        if DROP_BLOCK_RE.match(line) or (DROP_VIEWS and VIEW_RE.match(line)):
            drop_block = ";" not in line
            i += 1; continue
        if DROP_LINE_RE.match(line):
            i += 1; continue

        stripped = line.lstrip()
        if stripped.startswith("--") or not stripped:
            out.write(line + "\n")
        elif stripped.startswith("INSERT INTO"):
            out.write(strip_schema(line) + "\n")
        else:
            out.write(clean_ddl(line) + "\n")
        i += 1


def main():
    configure()
    files = os.environ.get("SQL_FILES", "").split() or sorted(glob.glob("*.sql"))
    files = [f for f in files if os.path.isfile(f)]
    if not files:
        sys.exit("pgsql transform: no SQL files to convert")

    for idx, path in enumerate(files):
        text = transcode(path)
        with open(path, "w", encoding="utf-8") as out:
            if idx == 0:
                out.write(PREAMBLE)
            convert_file(text, out)
            if idx == len(files) - 1:
                out.write(POSTAMBLE)


if __name__ == "__main__":
    main()
