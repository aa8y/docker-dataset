#!/usr/bin/env bash
# Materializes the published tags after a per-arch push -- without reading a
# single manifest back from Docker Hub.
#
# `dave push` with TAG_SUFFIX set publishes one single-arch image per
# architecture -- `<repo>:<tag>-amd64`, `<repo>:<tag>-arm64` -- because the two
# arches are built on their own runners, and bin/push-image records each pushed
# manifest's descriptor (digest, size, media type, platform) into
# DESCRIPTOR_DIR. This assembles, from those descriptors alone, the OCI image
# index for every real tag (pass 1) and PUTs it to the registry as
# `<repo>:<tag>`; then PUTs the same index again under every alias tag
# (`retagFrom:` in manifest.yml, e.g. `latest`; pass 2).
#
# Why not `docker buildx imagetools create`: it re-reads both per-arch
# manifests and their configs to build the index, and Docker Hub counts each of
# those GETs as a pull against the account's hourly quota -- ~3 per tag, ~500
# for a full pass, against a 200-pull allowance. A manifest PUT is not metered,
# and every byte an index needs is already known to the shard that pushed the
# image. Docker Hub validates that the referenced manifests exist in the
# repository at PUT time, so a bad descriptor fails loudly rather than
# publishing a dangling tag.
#
# Done-stamps (opt-in): when MERGE_STAMP_DIR names a directory, each target tag
# that lands leaves a stamp there, and a stamped tag is skipped on the next
# invocation. CI persists the directory across re-run attempts of the same
# commit, so a run that dies part-way only redoes the remainder. The stamps are
# keyed by target ref only, which is safe exactly because the cache scope is one
# commit's attempts -- the per-arch source images cannot change under a stamp
# within that scope.
#
# Credentials: DOCKERHUB_USERNAME / DOCKERHUB_TOKEN when set (CI); otherwise the
# credential helper `docker login` configured in ~/.docker/config.json, so a
# human who is logged in can run this as-is. The secret is only ever handed to
# curl through a config file on stdin, never as an argument.
#
# Usage: merge-manifests [-c <context>] [-m <manifest>] [-n|--dry-run]
#   DESCRIPTOR_DIR   directory of descriptor files written by bin/push-image
#                    (required unless --dry-run)
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
manifest="$root/manifest.yml"
context=""
dry_run=0
registry="https://registry-1.docker.io"
auth_url="https://auth.docker.io/token?service=registry.docker.io"
index_type="application/vnd.oci.image.index.v1+json"

while [ $# -gt 0 ]; do
  case "$1" in
    -c|--context) context="${2-}"; shift 2 ;;
    -m|--manifest) manifest="${2-}"; shift 2 ;;
    -n|--dry-run) dry_run=1; shift ;;
    -h|--help) echo "Usage: merge-manifests [-c <context>] [-m <manifest>] [-n|--dry-run]" >&2; exit 0 ;;
    *) echo "merge-manifests: unknown argument: $1" >&2; exit 2 ;;
  esac
done

# Manifest as JSON, so the extraction below is a single jq program regardless of
# which reader is available. yq is preferred (present on GitHub's runners);
# otherwise any python3 that can import PyYAML will do. NOTE: the twin of this
# function lives in bin/dataset-checksums -- keep them in step.
manifest_json() {
  local out py
  if command -v yq >/dev/null 2>&1 && out="$(yq -o=json '.' "$manifest" 2>/dev/null)" && [ -n "$out" ]; then
    printf '%s' "$out"
    return 0
  fi
  for py in python3 "$root/.venv/bin/python" python; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import yaml' 2>/dev/null; then
      "$py" -c 'import json, sys, yaml; json.dump(yaml.safe_load(open(sys.argv[1])), sys.stdout)' "$manifest"
      return 0
    fi
  done
  echo "merge-manifests: need yq, or a python3 with PyYAML, to read $manifest" >&2
  return 1
}

# One target per line, tab-separated: `<repo> <tag> <source-tag> <arches>`,
# sorted for a stable run. `pass` 1 is the real tags (source == tag), 2 the
# aliases (source == retagFrom). A context's own parameters.repository wins over
# the global one. The arch suffixes come from parameters.platforms, which is
# also what dave passes to `--platform`, so the names here cannot drift from
# what CI pushed.
target_lines() {
  manifest_json | jq -r --arg ctx "$context" --arg pass "$1" '
    (.parameters.repository // "") as $global
    | (.parameters.platforms // "linux/amd64,linux/arm64"
       | split(",") | map(sub("^.*/"; "")) | join(",")) as $arches
    | [ (.contexts // {})
        | to_entries[]
        | select($ctx == "" or .key == $ctx)
        | (((.value // {}).parameters // {}).repository // $global) as $repo
        | ((.value // {}).tags // {}) | to_entries[]
        | .key as $tag
        | ((.value // {}).retagFrom // "") as $from
        | select(if $pass == "1" then $from == "" else $from != "" end)
        | [$repo, $tag, (if $from == "" then $tag else $from end), $arches] | @tsv
      ] | sort[]'
}

sha256_of() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1
}

# Every descriptor file, as one JSON array. Empty when DESCRIPTOR_DIR is unset,
# which only --dry-run tolerates.
load_descriptors() {
  if [ -z "${DESCRIPTOR_DIR:-}" ]; then
    [ "$dry_run" -eq 1 ] || { echo "merge-manifests: DESCRIPTOR_DIR is required (see bin/push-image)" >&2; return 1; }
    echo '[]'
    return 0
  fi
  [ -d "$DESCRIPTOR_DIR" ] || { echo "merge-manifests: DESCRIPTOR_DIR '$DESCRIPTOR_DIR' is not a directory" >&2; return 1; }
  local files
  files="$(find "$DESCRIPTOR_DIR" -name '*.json' | sort)"
  if [ -z "$files" ]; then
    [ "$dry_run" -eq 1 ] || { echo "merge-manifests: no descriptor files in $DESCRIPTOR_DIR" >&2; return 1; }
    echo '[]'
    return 0
  fi
  printf '%s\n' "$files" | tr '\n' '\0' | xargs -0 jq -s '.'
}

# The index for `<repo>:<source>` from its per-arch descriptors, compact and
# key-ordered so an alias assembled from the same descriptors is byte-for-byte
# the source's index. Fails (exit 1, message on stderr) when any arch is
# missing -- a partial index would publish a tag that silently lacks a
# platform.
compose_index() {
  local repo="$1" source="$2" arches="$3"
  printf '%s' "$descriptors" | jq -c -e \
      --arg repo "$repo" --arg src "$source" --arg arches "$arches" '
    ($arches | split(",")) as $want
    | [ .[] | select(.repository == $repo and .tag == $src) ] as $have
    | ($want | map(. as $a | ($have | map(select(.target == ($src + "-" + $a))) | .[0]))) as $picked
    | if any($picked[]; . == null) then
        error("missing per-arch descriptor for \($repo):\($src) -- have "
              + ([$have[].target] | join(", ") | if . == "" then "none" else . end)
              + ", want " + ($want | map($src + "-" + .) | join(", ")))
      else
        { schemaVersion: 2, mediaType: "application/vnd.oci.image.index.v1+json",
          manifests: ($picked | map({ mediaType, digest, size, platform })) }
      end' 2>&1 | sed 's/^jq: error ([^)]*): //'
}

# A bearer token with push rights on one repository, cached per repository for
# the run. Credentials go to curl as a config document on stdin so the secret
# never appears in an argument list.
token_dir="$(mktemp -d)"
trap 'rm -rf "$token_dir"' EXIT
token_for() {
  local repo="$1" cache user secret helper creds
  cache="$token_dir/$(printf '%s' "$repo" | tr '/' '_')"
  if [ -s "$cache" ]; then cat "$cache"; return 0; fi
  if [ -n "${DOCKERHUB_USERNAME:-}" ] && [ -n "${DOCKERHUB_TOKEN:-}" ]; then
    user="$DOCKERHUB_USERNAME"; secret="$DOCKERHUB_TOKEN"
  else
    helper="$(jq -r '.credHelpers["index.docker.io"] // .credsStore // ""' "${DOCKER_CONFIG:-$HOME/.docker}/config.json" 2>/dev/null || true)"
    [ -n "$helper" ] || { echo "merge-manifests: no DOCKERHUB_USERNAME/DOCKERHUB_TOKEN and no docker credential helper configured" >&2; return 1; }
    creds="$(printf 'https://index.docker.io/v1/' | "docker-credential-$helper" get)" \
      || { echo "merge-manifests: docker-credential-$helper has no Docker Hub login (run 'docker login')" >&2; return 1; }
    user="$(printf '%s' "$creds" | jq -r .Username)"
    secret="$(printf '%s' "$creds" | jq -r .Secret)"
  fi
  printf 'user = "%s:%s"\n' "$user" "$secret" \
    | curl -fsS --config - "$auth_url&scope=repository:$repo:pull,push" \
    | jq -r '.token // empty' > "$cache"
  [ -s "$cache" ] || { echo "merge-manifests: could not obtain a push token for $repo" >&2; return 1; }
  cat "$cache"
}

# PUT one index and confirm the registry stored exactly those bytes.
put_index() {
  local repo="$1" tag="$2" body="$3" headers token expect got
  headers="$(mktemp)"
  token="$(token_for "$repo")"
  expect="sha256:$(sha256_of "$body")"
  if ! curl -fsS -o /dev/null -D "$headers" -X PUT \
        -H "Authorization: Bearer $token" -H "Content-Type: $index_type" \
        --data-binary @"$body" "$registry/v2/$repo/manifests/$tag"; then
    rm -f "$headers"; return 1
  fi
  got="$(tr -d '\r' < "$headers" | awk 'tolower($1) == "docker-content-digest:" {print $2}')"
  rm -f "$headers"
  if [ "$got" != "$expect" ]; then
    echo "merge-manifests: $repo:$tag stored as $got, expected $expect" >&2
    return 1
  fi
}

# Serial on purpose: a PUT is a few hundred bytes and returns in well under a
# second, so even the full tag list finishes in minutes, and one writer never
# trips the registry's abuse limiter. The stamp is written only after the PUT
# and digest check both pass.
run_pass() {
  local label="$1" lines="$2" repo tag source arches index body stamp
  [ -n "$lines" ] || { echo "merge-manifests: $label: nothing to do" >&2; return 0; }
  body="$(mktemp)"
  while IFS="$(printf '\t')" read -r repo tag source arches; do
    if [ -n "${MERGE_STAMP_DIR:-}" ]; then
      stamp="${MERGE_STAMP_DIR}/$(printf '%s' "$repo:$tag" | tr -c 'A-Za-z0-9._-' '-')"
      if [ -f "$stamp" ]; then
        echo "merge-manifests: $repo:$tag already merged in an earlier attempt; skipping" >&2
        continue
      fi
    fi
    if [ "$dry_run" -eq 1 ]; then
      if index="$(compose_index "$repo" "$source" "$arches")"; then
        echo "PUT $repo:$tag <- $(printf '%s' "$index" | jq -r '[.manifests[] | "\(.platform.architecture)=\(.digest)"] | join(" ")')"
      else
        echo "PUT $repo:$tag <- $source-{$arches} (no descriptors loaded)"
      fi
      continue
    fi
    index="$(compose_index "$repo" "$source" "$arches")" \
      || { echo "merge-manifests: $index" >&2; rm -f "$body"; return 1; }
    printf '%s' "$index" > "$body"
    put_index "$repo" "$tag" "$body" || { rm -f "$body"; return 1; }
    echo "merge-manifests: $repo:$tag <- $(printf '%s' "$index" | jq -r '[.manifests[].platform.architecture] | join("+")')" >&2
    if [ -n "${MERGE_STAMP_DIR:-}" ]; then : > "$stamp"; fi
  done <<EOF
$lines
EOF
  rm -f "$body"
}

# The stamp dir exists up front so a run that fails before its first clean
# merge still leaves a valid (empty) directory for CI to persist.
[ -z "${MERGE_STAMP_DIR:-}" ] || mkdir -p "$MERGE_STAMP_DIR"

# Collected before either pass runs, and via plain assignments so that `set -e`
# sees a failing extraction (inside a command substitution used as an argument
# it would be swallowed, and the pass would look merely empty).
descriptors="$(load_descriptors)"
pass1="$(target_lines 1)"
pass2="$(target_lines 2)"
if [ -z "$pass1" ] && [ -z "$pass2" ]; then
  echo "merge-manifests: no tags found${context:+ for context '$context'} in $manifest" >&2
  exit 1
fi

echo "merge-manifests: pass 1 -- multi-arch tags${context:+ (context $context)}" >&2
run_pass 'pass 1' "$pass1"
echo "merge-manifests: pass 2 -- alias tags" >&2
run_pass 'pass 2' "$pass2"
