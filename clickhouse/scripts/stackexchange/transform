#!/usr/bin/env python3
"""Transform a StackExchange XML dump into a ClickHouse SQL script.

A near-copy of ../../../duckdb/scripts/stackexchange/transform, which in turn
came from the SQLite one -- the source of truth for the schema and the
XML-attribute -> column mapping, all of them adapted (like the postgres/mysql
hooks) from stackexchange-dump-to-postgres,
https://github.com/Human-Centric-Machine-Learning/stackexchange-dump-to-postgres.
It is carried here as a real file rather than a symlink because each image's
docker build context is its own engine directory: `COPY scripts/` in
clickhouse/Dockerfile can only see clickhouse/scripts, so a link across engine
directories would escape the context. That is why every engine already ships its
own copy of this hook.

A StackExchange site dump is a set of per-table XML files, one ``<row .../>``
element per record with the column values held as element attributes. This hook
converts each table that is present into ``CREATE TABLE`` + batched multi-row
``INSERT`` statements, assembling a single ``<dataset>.sql`` that the build
prepends a ``USE <dataset>;`` header to and the entrypoint runs at first start.

Four things differ from the DuckDB emitter, all verified against ClickHouse
26.8.2 (the pinned server):

  * **Every table names an engine and a sorting key**: ``ENGINE = MergeTree
    ORDER BY (`Id`)``. Left unsaid, ClickHouse's ``default_table_engine`` would
    still give a MergeTree -- but with ``ORDER BY tuple()``, no sorting key at
    all, which throws away the one thing these tables have. ``Id`` is the dump's
    own per-table primary key: it is unique, it is what the other engines
    declare as ``PRIMARY KEY``, and MergeTree's sparse index over it makes id
    lookups and ranges cheap. Because a sorting-key column cannot be Nullable
    ("Sorting key contains nullable columns, but merge tree setting
    `allow_nullable_key` is disabled", code 44), ``Id`` is the one non-Nullable
    column; every other column is ``Nullable(...)``, since these dumps omit an
    attribute whenever a value was never recorded and ClickHouse columns are
    otherwise NOT NULL -- and a NULL written into one of those is not rejected
    but silently stored as the type's zero.
  * **No indexes.** The other engines emit a dozen ``CREATE INDEX`` statements
    per site after the bulk load. ClickHouse has no comparable object:
    ``CREATE INDEX`` there declares a *data-skipping* index
    (``TYPE``/``GRANULARITY``, and the postgres form's ``USING btree`` is a
    syntax error), and the ordinary "look this column up quickly" job is the
    sorting key's. Emitting the same set would be cargo cult, so the tables
    carry their sorting key and nothing else. The index list is still carried in
    TABLES below, because the unit tests compare it across dialects to catch the
    shared schema drifting.
  * **Backslashes are escaped.** ClickHouse interprets escape sequences inside
    string literals, where SQLite and DuckDB do not, so an ``AboutMe`` or
    ``Body`` containing a Windows path or a LaTeX macro would silently change
    (``\\n`` in a post would become a real newline). ``sql_str`` therefore
    doubles the backslash and escapes tab/newline/CR as well, keeping every
    emitted row on one line.
  * **``CreationDate`` and friends are ``DateTime64(3)``**, not TIMESTAMP.
    The dumps' millisecond ISO-8601 literals (``2014-01-21T20:26:05.043``) go
    in as they are: ClickHouse's DateTime64 text parser accepts the ``T``
    separator, so unlike the MySQL hook there is no separator rewrite, and the
    (3) matches the milliseconds the dumps actually carry.

There is also no ``BEGIN``/``COMMIT`` wrapper. ClickHouse's transactions are an
experimental, differently-spelled feature and a bare ``BEGIN;`` is a syntax
error; a MergeTree insert is atomic per part anyway.

Every StackExchange site shares this identical schema, so this hook is
site-agnostic: each site's dataset directory (e.g. scripts/beer, scripts/coffee)
is a symlink to scripts/stackexchange, and the only thing that varies per site
is $DATASET (the database/output-file name). Unknown attributes from refreshed
dumps (e.g. ContentLicense) are ignored because every INSERT uses an explicit
column list.
"""
import os
import sys

from lxml import etree

INT, TS, TXT = "Int32", "DateTime64(3)", "String"

# Each table: (xml_file, table, columns, indexes). A column is
# (xml_attribute, sql_column, type); the first column is the sorting key. The
# index list is carried unchanged from the other engines' hooks -- the unit
# tests compare it across dialects to catch schema drift -- but nothing is
# emitted from it here (see the module docstring).
TABLES = [
    ("Users.xml", "Users", [
        ("Id", "Id", INT), ("Reputation", "Reputation", INT),
        ("CreationDate", "CreationDate", TS), ("DisplayName", "DisplayName", TXT),
        ("LastAccessDate", "LastAccessDate", TS), ("WebsiteUrl", "WebsiteUrl", TXT),
        ("Location", "Location", TXT), ("AboutMe", "AboutMe", TXT),
        ("Views", "Views", INT), ("UpVotes", "UpVotes", INT),
        ("DownVotes", "DownVotes", INT), ("ProfileImageUrl", "ProfileImageUrl", TXT),
        ("Age", "Age", INT), ("AccountId", "AccountId", INT),
    ], [
        ("users_account_id_idx", ["AccountId"]),
        ("users_display_name_idx", ["DisplayName"]),
        ("users_up_votes_idx", ["UpVotes"]),
        ("users_down_votes_idx", ["DownVotes"]),
        ("users_creation_date_idx", ["CreationDate"]),
    ]),
    ("Posts.xml", "Posts", [
        ("Id", "Id", INT), ("PostTypeId", "PostTypeId", INT),
        ("AcceptedAnswerId", "AcceptedAnswerId", INT), ("ParentId", "ParentId", INT),
        ("CreationDate", "CreationDate", TS), ("Score", "Score", INT),
        ("ViewCount", "ViewCount", INT), ("Body", "Body", TXT),
        ("OwnerUserId", "OwnerUserId", INT), ("LastEditorUserId", "LastEditorUserId", INT),
        ("LastEditorDisplayName", "LastEditorDisplayName", TXT),
        ("LastEditDate", "LastEditDate", TS), ("LastActivityDate", "LastActivityDate", TS),
        ("Title", "Title", TXT), ("Tags", "Tags", TXT),
        ("AnswerCount", "AnswerCount", INT), ("CommentCount", "CommentCount", INT),
        ("FavoriteCount", "FavoriteCount", INT), ("ClosedDate", "ClosedDate", TS),
        ("CommunityOwnedDate", "CommunityOwnedDate", TS),
    ], [
        ("posts_post_type_id_idx", ["PostTypeId"]),
        ("posts_score_idx", ["Score"]),
        ("posts_creation_date_idx", ["CreationDate"]),
        ("posts_owner_user_id_idx", ["OwnerUserId"]),
        ("posts_answer_count_idx", ["AnswerCount"]),
        ("posts_comment_count_idx", ["CommentCount"]),
        ("posts_favorite_count_idx", ["FavoriteCount"]),
        ("posts_view_count_idx", ["ViewCount"]),
        ("posts_accepted_answer_id_idx", ["AcceptedAnswerId"]),
        ("posts_parent_id_idx", ["ParentId"]),
    ]),
    ("Comments.xml", "Comments", [
        ("Id", "Id", INT), ("PostId", "PostId", INT), ("Score", "Score", INT),
        ("Text", "Text", TXT), ("CreationDate", "CreationDate", TS),
        ("UserId", "UserId", INT),
    ], [
        ("comments_score_idx", ["Score"]),
        ("comments_post_id_idx", ["PostId"]),
        ("comments_creation_date_idx", ["CreationDate"]),
        ("comments_user_id_idx", ["UserId"]),
    ]),
    ("Votes.xml", "Votes", [
        ("Id", "Id", INT), ("PostId", "PostId", INT), ("VoteTypeId", "VoteTypeId", INT),
        ("UserId", "UserId", INT), ("CreationDate", "CreationDate", TS),
        ("BountyAmount", "BountyAmount", INT),
    ], [
        ("votes_post_id_idx", ["PostId"]),
        ("votes_type_idx", ["VoteTypeId"]),
        ("votes_creation_date_idx", ["CreationDate"]),
    ]),
    ("Badges.xml", "Badges", [
        ("Id", "Id", INT), ("UserId", "UserId", INT), ("Name", "Name", TXT),
        ("Date", "Date", TS),
    ], [
        ("badges_user_id_idx", ["UserId"]),
        ("badges_name_idx", ["Name"]),
        ("badges_date_idx", ["Date"]),
    ]),
    ("Tags.xml", "Tags", [
        ("Id", "Id", INT), ("TagName", "TagName", TXT), ("Count", "Count", INT),
        ("ExcerptPostId", "ExcerptPostId", INT), ("WikiPostId", "WikiPostId", INT),
    ], [
        ("tags_count_idx", ["Count"]),
        ("tags_name_idx", ["TagName"]),
    ]),
    ("PostLinks.xml", "PostLinks", [
        ("Id", "Id", INT), ("CreationDate", "CreationDate", TS), ("PostId", "PostId", INT),
        ("RelatedPostId", "RelatedPostId", INT), ("LinkTypeId", "LinkTypeId", INT),
    ], [
        ("post_links_post_id_idx", ["PostId"]),
        ("post_links_related_post_id_idx", ["RelatedPostId"]),
    ]),
    ("PostHistory.xml", "PostHistory", [
        ("Id", "Id", INT), ("PostHistoryTypeId", "PostHistoryTypeId", INT),
        ("PostId", "PostId", INT), ("RevisionGUID", "RevisionGUID", TXT),
        ("CreationDate", "CreationDate", TS), ("UserId", "UserId", INT),
        ("Text", "PostText", TXT),
    ], [
        ("post_history_type_id_idx", ["PostHistoryTypeId"]),
        ("post_history_post_id_idx", ["PostId"]),
        ("post_history_revision_guid_idx", ["RevisionGUID"]),
        ("post_history_creation_date_idx", ["CreationDate"]),
        ("post_history_user_id_idx", ["UserId"]),
    ]),
]

# Rows per emitted INSERT. Larger than the other engines' 500 on purpose: every
# INSERT into a MergeTree table writes a new part, and the bigger sites run to
# hundreds of thousands of rows per table.
BATCH = 1000

# ClickHouse reads backslash escapes inside string literals, so the backslash
# itself has to be doubled and the control characters a post body may carry are
# written as escapes rather than as raw bytes -- which also keeps each emitted
# row on a single line. The quote is doubled, the escape both dialects share.
_ESCAPE = {"\\": "\\\\", "'": "''", "\t": "\\t", "\n": "\\n", "\r": "\\r"}


def sql_str(value):
    """Render a string as a single-line ClickHouse string literal."""
    return "'" + "".join(_ESCAPE.get(c, c) for c in value) + "'"


def value(attribs, xml_attr, col_type):
    v = attribs.get(xml_attr)
    if v is None or (col_type != TXT and v == ""):
        return "NULL"
    if col_type == INT:
        return v
    return sql_str(v)


def ddl(table, columns):
    """CREATE TABLE for one dump table: MergeTree keyed on its first column."""
    defs = []
    for i, (_, col, col_type) in enumerate(columns):
        # The sorting key is the one column that cannot be Nullable; every
        # other attribute is optional in these dumps.
        defs.append('  `{}` {}'.format(
            col, col_type if i == 0 else "Nullable({})".format(col_type)))
    key = columns[0][1]
    return 'CREATE TABLE `{}` (\n{}\n) ENGINE = MergeTree ORDER BY (`{}`);\n'.format(
        table, ",\n".join(defs), key)


def main():
    dataset = os.environ.get("DATASET", "stackexchange")
    present = [t for t in TABLES if os.path.exists(t[0])]
    if not present:
        sys.exit("stackexchange transform: no StackExchange XML files found")

    with open("{}.sql".format(dataset), "w", encoding="utf-8") as out:
        out.write("-- StackExchange data dump, converted from XML at build time.\n")
        out.write("-- See clickhouse/scripts/stackexchange/transform.\n\n")

        for xml_file, table, columns, _ in present:
            out.write(ddl(table, columns))
            col_list = ", ".join('`{}`'.format(col) for _, col, _ in columns)
            insert_head = 'INSERT INTO `{}` ({}) VALUES\n'.format(table, col_list)

            batch = []

            def flush():
                if batch:
                    out.write(insert_head + ",\n".join(batch) + ";\n")
                    batch.clear()

            for _, elem in etree.iterparse(xml_file, events=("end",)):
                if elem.tag == "row":
                    row = ", ".join(value(elem.attrib, xa, ct) for xa, _, ct in columns)
                    batch.append("({})".format(row))
                    if len(batch) >= BATCH:
                        flush()
                elem.clear()
                while elem.getprevious() is not None:
                    del elem.getparent()[0]
            flush()
            out.write("\n")


if __name__ == "__main__":
    main()
