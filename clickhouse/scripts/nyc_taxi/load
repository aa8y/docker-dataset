#!/usr/bin/env bash
# Ship the Parquet file next to the init script so the `INSERT ... FROM INFILE`
# the transform hook authored resolves at container start. ClickHouse loads at
# first boot rather than at build time, so unlike the DuckDB tag the 73.5 MB
# file is part of the image rather than being left behind in the builder.
set -e
mkdir -p "/docker-entrypoint-initdb.d/${DATASET}"
mv ./*.parquet "/docker-entrypoint-initdb.d/${DATASET}/"
