#!/usr/bin/env bash
# GeoNames ships cities15000 as a zip holding a single tab-separated export
# (cities15000.txt). The generic EXTRACT_URL fetch downloads the .zip; here we
# unpack it in place so the transform step sees the plain text file, then drop
# the archive. `unzip` is part of the builder's shared tool set, so no
# extraPrereqs are needed for this step.
#
# Identical to ../../../cockroach/scripts/geonames/extract: the unpacking is the
# same regardless of what the engine does with the file afterwards.
set -e
for archive in ./*.zip; do
  unzip -o -q "$archive"
  rm -f "$archive"
done
